rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vercel's server owns payments and publication. Browsers never write here.
    match /mela_stalls/{document} { allow read, write: if false; }
    match /mela_stall_rate_limits/{document} { allow read, write: if false; }
    match /mela_payment_blocks/{document} { allow read, write: if false; }
  }
}
