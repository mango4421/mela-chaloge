{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mela-chaloge.vercel.app"
        }
      ],
      "destination": "https://melachaloge.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.melachaloge.online"
        }
      ],
      "destination": "https://melachaloge.online/:path*",
      "permanent": true
    },
    {
      "source": "/assets/mela-panorama.png",
      "destination": "/assets/optimized/panorama-c20ba02aa128.webp",
      "permanent": true
    },
    {
      "source": "/assets/mela-stall-atlas.png",
      "destination": "/assets/optimized/stallAtlas-fa1b53076153.webp",
      "permanent": true
    },
    {
      "source": "/assets/mela-stall-atlas.webp",
      "destination": "/assets/optimized/stallAtlas-fa1b53076153.webp",
      "permanent": true
    }
  ]
}
